{
  "name": "ear-trainer",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build:purs && npm run build:backend && vite build --base ./",
    "build:purs": "spago build -p ear-trainer-app",
    "build:backend": "purs-backend-es bundle-app --main Main --platform browser --to app.js --source-maps",
    "dev": "npm run build:purs && npm run build:backend && vite",
    "format": "purs-tidy format-in-place 'app/**/*.purs' 'packages/**/*.purs' 'test/**/*.purs'",
    "format:check": "purs-tidy check 'app/**/*.purs' 'packages/**/*.purs' 'test/**/*.purs'",
    "icons": "node scripts/generate-icons.js",
    "licenses": "node scripts/generate-third-party-notices.js",
    "licenses:check": "node scripts/generate-third-party-notices.js --check",
    "test": "spago test -p ear-trainer-quiz-engine",
    "validate": "npm run format:check && npm run test && npm run licenses:check && npm run build"
  },
  "dependencies": {
    "pitchy": "4.1.0",
    "tone": "15.1.22",
    "vexflow": "5.0.0"
  },
  "devDependencies": {
    "purescript": "0.15.16",
    "purs-backend-es": "1.4.3",
    "purs-tidy": "0.11.1",
    "sharp": "^0.35.3",
    "spago": "1.0.4",
    "vite": "8.2.0"
  }
}
